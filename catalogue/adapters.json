        "license": "Internal-Proprietary",
        "owner": "Tool Repository",
        "status": "draft",
        "summary": "Validates bounded SSH targets for fixed T480 operations without opening a remote session.",
        "title": "T480 Transport Safety",
        "version": "0.1.0"
      },
      "capabilities": [
        {
          "description": "Validate a safe SSH target.",
          "name": "target_validation"
        }
      ],
      "documentation": {
        "knowledge_base": "adapters/t480-transport/knowledge.json",
        "user_guide": "docs/adapters/t480-transport.md"
      },
      "manifest_sha256": "d462e986991269a72220046785629313a3438c38ebba15fcebaf425c2543e70f",
      "operations": [
        {
          "capability": "target_validation",
          "idempotency": "idempotent",
          "input_schema": {
            "additionalProperties": false,
            "properties": {
              "target": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                "type": "string"
              }
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "name": "validate_target",
          "output_schema": {
            "properties": {
              "target": {
                "type": "string"
              }
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "retry_guidance": "No retry is required.",
          "side_effect": "read_only",
          "summary": "Validate one SSH target.",
          "timeout_seconds": 1
        }
      ],
