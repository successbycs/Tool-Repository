{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-repository.local/schemas/catalogue-1.0.0.schema.json",
  "title": "Tool Repository Read-only Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_index_sha256", "model_profiles_sha256", "model_profiles", "prompt_template_assets_sha256", "prompts", "templates", "goals", "adapters"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_index_sha256": {"$ref": "#/$defs/sha256"},
    "model_profiles_sha256": {"$ref": "#/$defs/sha256"},
    "model_profiles": {"type": "array", "items": {"$ref": "#/$defs/modelProfile"}},
    "prompt_template_assets_sha256": {"$ref": "#/$defs/sha256"},
    "prompts": {"type": "array", "items": {"$ref": "#/$defs/prompt"}},
    "templates": {"type": "array", "items": {"$ref": "#/$defs/template"}},
    "goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "adapters": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["publisher", "release_tag", "release_commit", "artifact_uri"],
      "properties": {
        "publisher": {"type": "string", "minLength": 2},
        "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "release_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "artifact_uri": {"type": "string", "pattern": "^git\\+https://"}
      }
    },
    "modelProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "roles", "ollama_model", "digest", "size_bytes", "parameters", "quantization", "input_modalities", "status", "local_only", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string"}, "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "ollama_model": {"type": "string", "pattern": ".+:"}, "digest": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}, "parameters": {"type": "string"}, "quantization": {"type": "string"}, "input_modalities": {"type": "array", "minItems": 1, "items": {"enum": ["text", "image"]}}, "status": {"const": "active"}, "local_only": {"const": true}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "title", "purpose", "owner", "data_classification", "definition_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/semver"}, "title": {"type": "string"}, "purpose": {"type": "string"}, "owner": {"type": "string"}, "data_classification": {"enum": ["public", "internal", "restricted"]}, "definition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "title", "purpose", "owner", "data_classification", "required_sections", "source_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/semver"}, "title": {"type": "string"}, "purpose": {"type": "string"}, "owner": {"type": "string"}, "data_classification": {"enum": ["public", "internal", "restricted"]}, "required_sections": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "title", "desired_outcome", "milestones", "approval_status", "source_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/semver"}, "title": {"type": "string"}, "desired_outcome": {"type": "string"}, "milestones": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TR-M[0-9]+[A-Z]?$"}}, "approval_status": {"const": "approved"}, "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "value", "capabilities", "operations", "documentation", "manifest_sha256", "release"],
      "properties": {
        "adapter": {"type": "object", "additionalProperties": false, "required": ["id", "version", "title", "summary", "status", "owner", "license"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/semver"}, "title": {"type": "string"}, "summary": {"type": "string"}, "status": {"enum": ["draft", "active", "deprecated", "archived"]}, "owner": {"type": "string"}, "license": {"type": "string"}}},
        "value": {"type": "object", "additionalProperties": false, "required": ["use_cases", "fit_for", "not_for", "limitations"], "properties": {"use_cases": {"type": "array", "items": {"type": "string"}}, "fit_for": {"type": "array", "items": {"type": "string"}}, "not_for": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}}},
        "capabilities": {"type": "array", "items": {"type": "object"}},
        "operations": {"type": "array", "items": {"type": "object"}},
        "documentation": {"type": "object", "additionalProperties": false, "required": ["user_guide", "knowledge_base"], "properties": {"user_guide": {"type": "string"}, "knowledge_base": {"type": "string"}}},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "release": {"$ref": "#/$defs/release"}
      }
    }
  }
}
