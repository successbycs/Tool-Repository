{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-repository.local/schemas/goal-record-1.0.0.schema.json",
  "title": "Tool Repository human-approved goal record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "desired_outcome", "scope", "non_goals", "success_criteria", "proof_requirements", "dependencies", "authority", "approval", "milestones"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/semver"},
    "title": {"type": "string", "minLength": 8, "maxLength": 160},
    "desired_outcome": {"type": "string", "minLength": 20, "maxLength": 1000},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "maxLength": 500}},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "maxLength": 500}},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "maxLength": 500}},
    "proof_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "maxLength": 500}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 160}},
    "authority": {"type": "string", "minLength": 5, "maxLength": 500},
    "approval": {"$ref": "#/$defs/approval"},
    "milestones": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TR-M[0-9]+[A-Z]?$"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status", "approved_by", "approved_on"], "properties": {"status": {"const": "approved"}, "approved_by": {"type": "string", "minLength": 2, "maxLength": 100}, "approved_on": {"type": "string", "format": "date"}}}
  }
}
