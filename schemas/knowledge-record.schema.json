{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-repository.local/schemas/knowledge-record-1.0.0.schema.json",
  "title": "Tool Repository knowledge base",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}}},
    "records": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/validatedUsage"}, {"$ref": "#/$defs/suggestedUse"}]}}
  },
  "$defs": {
    "validatedUsage": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "observed_on", "context", "outcome", "constraints_or_lessons", "evidence_ref", "redaction_attestation", "reviewed_by"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "kind": {"const": "validated_usage"}, "observed_on": {"type": "string", "format": "date"}, "context": {"type": "string", "minLength": 10, "maxLength": 500}, "outcome": {"type": "string", "minLength": 10, "maxLength": 500}, "constraints_or_lessons": {"type": "string", "minLength": 10, "maxLength": 500}, "evidence_ref": {"type": "string", "minLength": 1}, "redaction_attestation": {"const": "sanitized_repository_evidence"}, "reviewed_by": {"type": "string", "minLength": 2, "maxLength": 100}}},
    "suggestedUse": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "use_case", "assumptions", "validation_required"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "kind": {"const": "suggested_use"}, "use_case": {"type": "string", "minLength": 10, "maxLength": 500}, "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "validation_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}}}
  }
}
