{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Repository milestone",
  "type": "object",
  "required": ["id", "title", "delivery_type", "status", "capability_unblocked", "dependencies", "risk_level", "review_requirements", "ingestion", "write_scope", "required_artifacts", "proof_artifact", "verify", "execution_brief"],
  "properties": {
    "id": {"type": "string", "pattern": "^TR-M[0-9]{2}[A-Z]?$"},
    "status": {"enum": ["not_started", "in_progress", "blocked", "complete"]},
    "risk_level": {"enum": ["low", "moderate", "high"]},
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies", "asset_types", "source_records", "verification", "catalogue_effect"],
      "properties": {
        "applies": {"type": "boolean"},
        "asset_types": {"type": "array", "items": {"enum": ["adapter", "local_model", "prompt", "harvested_asset"]}},
        "source_records": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "catalogue_effect": {"enum": ["publish", "retire", "not_published", "not_applicable"]}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "write_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "not": {"pattern": "[<>]"}}},
    "proof_artifact": {"type": "string"},
    "verify": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
