{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-repository.local/schemas/prompt-definition-1.0.0.schema.json",
  "title": "Tool Repository reusable prompt definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "purpose", "owner", "data_classification", "input_contract", "output_contract", "constraints", "rendering"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 160},
    "purpose": {"type": "string", "minLength": 20, "maxLength": 1000},
    "owner": {"type": "string", "minLength": 2, "maxLength": 100},
    "data_classification": {"enum": ["public", "internal", "restricted"]},
    "input_contract": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contractField"}},
    "output_contract": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contractField"}},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "maxLength": 500}},
    "rendering": {"$ref": "#/$defs/rendering"}
  },
  "$defs": {
    "contractField": {"type": "object", "additionalProperties": false, "required": ["name", "description", "classification"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "description": {"type": "string", "minLength": 5, "maxLength": 500}, "classification": {"enum": ["public", "internal", "restricted"]}}},
    "rendering": {"type": "object", "additionalProperties": false, "required": ["template", "execution_capture"], "properties": {"template": {"type": "string", "minLength": 30, "maxLength": 12000}, "execution_capture": {"enum": ["redacted_canonical", "protected_reference"]}}}
  }
}
