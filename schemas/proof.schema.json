{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Repository milestone proof",
  "type": "object",
  "required": ["milestone_id", "implementation_revision", "generated_at", "environment", "status", "verification", "observed_result"],
  "properties": {
    "milestone_id": {"type": "string"},
    "implementation_revision": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "object"},
    "status": {"enum": ["passed", "failed"]},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "exit_code", "output_sha256"]}},
    "observed_result": {"type": "string", "minLength": 1}
  }
}
