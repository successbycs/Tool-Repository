{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-repository.local/schemas/repository-intake-1.0.0.schema.json",
  "title": "Tool Repository read-only repository intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/queueSource"}}
  },
  "$defs": {
    "sourceIdentity": {"type": "object", "required": ["id", "location", "revision", "owner", "license_status"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "location": {"type": "string", "minLength": 3}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "owner": {"type": "string", "minLength": 2}, "license_status": {"enum": ["confirmed", "unresolved", "unknown"]}}},
    "queueSource": {"allOf": [{"$ref": "#/$defs/sourceIdentity"}, {"type": "object", "required": ["status", "review_status", "assessment"], "properties": {"status": {"enum": ["queued", "assessing", "assessed", "blocked"]}, "review_status": {"enum": ["pending", "passed", "failed"]}, "assessment": {"type": "string", "minLength": 1}}}]},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["id", "category", "decision", "target", "evidence", "reusable_value", "security_posture", "admission_gaps", "acceptance_checks", "owner", "effort"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "category": {"enum": ["adapter_tool", "workflow_integration", "solution_template", "prompt_or_evaluation_asset", "schema_or_contract", "documentation_or_knowledge", "reference_only", "reject"]}, "decision": {"enum": ["adopt", "extract", "rewrite", "defer", "reference_only", "reject"]}, "target": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "reusable_value": {"type": "string", "minLength": 10}, "security_posture": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "admission_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "owner": {"type": "string", "minLength": 2}, "effort": {"enum": ["small", "medium", "large"]}}},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["schema_version", "source", "inspection_mode", "candidates", "do_not_import", "review_records", "promotion_decision"], "properties": {"schema_version": {"const": "1.0.0"}, "source": {"$ref": "#/$defs/sourceIdentity"}, "inspection_mode": {"const": "read_only_static"}, "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "do_not_import": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}, "review_records": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 5}}, "promotion_decision": {"enum": ["none", "stage_approved", "deferred"]}}}
  }
}
